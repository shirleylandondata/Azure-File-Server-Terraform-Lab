# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files containing secrets
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Saved Terraform deployment plans
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Local environment and credentials
.env
.env.*
*.pem
*.pfx
*.key

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
